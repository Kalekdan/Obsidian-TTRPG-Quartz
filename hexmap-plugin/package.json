{
  "name": "hexmap-plugin",
  "version": "1.0.0",
  "description": "Quartz HexMap component plugin for JSON-based hex maps",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsup src/index.ts src/components/index.ts --format esm --dts --out-dir dist",
    "dev": "tsup src/index.ts src/components/index.ts --format esm --dts --watch --out-dir dist"
  },
  "keywords": [
    "quartz",
    "plugin",
    "hexmap",
    "ttrpg"
  ],
  "peerDependencies": {
    "preact": "^10.0.0"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.3",
    "preact": "^10.28.2"
  },
  "quartz": {
    "name": "hexmap-plugin",
    "displayName": "Hex Map",
    "category": [
      "component"
    ],
    "version": "1.0.0",
    "quartzVersion": ">=5.0.0",
    "dependencies": [],
    "defaultOrder": 50,
    "defaultEnabled": true,
    "defaultOptions": {},
    "components": {
      "HexMapViewer": {
        "displayName": "Hex Map",
        "defaultPosition": "beforeBody",
        "defaultPriority": 40
      }
    }
  }
}
